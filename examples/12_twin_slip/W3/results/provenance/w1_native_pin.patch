 {
+    // A pinned node is a fixed spatial anchor, regardless of argument order.
+    // Keep its tag and constraint, and reject merges that would move either
+    // pinned endpoint (including attempts to combine distinct fixed anchors).
+    if (nodes[n2].constraint == PINNED_NODE && nodes[n1].constraint != PINNED_NODE)
+        std::swap(n1, n2);
+    for (int n : {n1, n2}) {
+        if (nodes[n].constraint == PINNED_NODE &&
+            (cell.pbc_position(nodes[n].pos, pos)-nodes[n].pos).norm2() > 1e-16)
+            return true;
+    }
